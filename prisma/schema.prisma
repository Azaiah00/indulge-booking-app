generator client {
  provider = "prisma-client-js"
}

// Connection URL is set in prisma.config.ts (Prisma 7+)
datasource db {
  provider = "postgresql"
}

// Users have an optional password (admin and members) and a role.
// Guest bookings do NOT use this model. They store contact info on the Appointment.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  // Hashed password (bcrypt). Optional so we can also support providers later.
  password      String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(CLIENT)
  phone         String?
  appointments  Appointment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  CLIENT
  ADMIN
}

model Service {
  id          String        @id @default(cuid())
  name        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  duration    Int           // Duration in minutes
  appointments Appointment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Appointment can be either:
//  - linked to a User (member) via userId, OR
//  - a guest booking with guestName/guestEmail/guestPhone filled in.
model Appointment {
  id          String            @id @default(cuid())

  // Optional: set if a logged-in member booked this appointment.
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Guest contact info (filled in for guest bookings).
  guestName   String?
  guestEmail  String?
  guestPhone  String?

  // Service this appointment is for.
  serviceId   String?
  service     Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  startTime   DateTime
  endTime     DateTime
  status      AppointmentStatus @default(PENDING)
  stripeId    String?           // For payment tracking
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Blockout {
  id          String    @id @default(cuid())
  title       String    // e.g., "Lunch Break", "Vacation"
  startTime   DateTime
  endTime     DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
